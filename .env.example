# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional. Board attachments already work on free vision models (see
# FREE_VISION_MODELS in lib/openrouterMessages.mjs), so leave this blank
# unless you want a specific model to be tried first. Anything set here
# leads, with the free list still behind it as fallback.
# e.g. openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=
APP_URL=https://your-app.vercel.app

# A password you choose to gate access to your own app
APP_PASSWORD=

# A long random string. Vercel auto-sends this as the cron request's
# Authorization header, so your cron route can verify it's really Vercel.
CRON_SECRET=
